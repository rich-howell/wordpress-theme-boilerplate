{
    "name": "rich-howell/Oswestry-SEN-Parents",
    "description": "A boilerplate for new wordpress themes",
    "type": "project",
    "authors": [
        {
            "name": "Rich Howell"
        }
    ],
    "scripts": {
        "lint": "vendor/bin/phpcs",
        "fix": "vendor/bin/phpcbf -d memory_limit=2048M",
        "post-install-cmd": "@php -r \"@mkdir('stubs', 0755, true); @copy('vendor/php-stubs/wordpress-stubs/wordpress-stubs.php', 'stubs/wordpress.php');\""
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcsstandards/phpcsutils": "^1.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "php-stubs/wordpress-stubs": "^6.8"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}